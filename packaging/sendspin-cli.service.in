# sendspin-cli as a system service. After installing:
#
#   systemd-sysusers
#   systemctl daemon-reload
#   systemctl enable --now sendspin-cli
#
# Configure it in /etc/sendspin-cli.conf. Subcommands need sudo: the socket is 0600 and owned
# by the service account. Needs systemd 236; the hardening block wants 247.

[Unit]
Description=Sendspin audio player
Documentation=https://github.com/Sendspin/sendspin-cpp-cli
# The player retries mDNS and dials on a backoff, so network-online.target buys nothing.
After=network.target sound.target
# Ordering only: an unavailable avahi-daemon is retried, not fatal.
After=avahi-daemon.service

[Service]
# Foreground; journald captures stderr.
Type=simple

# Created by lib/sysusers.d/sendspin-cli.conf, which also adds the audio group membership.
# Not DynamicUser=: it gets no audio group.
User=sendspin-cli

# Hardening, each directive verified against a running player.
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes

# Read-only except RuntimeDirectory= and StateDirectory=, so logfile/pidfile elsewhere fail.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# ProtectProc= hides other users' processes but not /proc/asound.
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# AF_NETLINK for getifaddrs(), which the default MAC-derived client id needs.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# @system-service covers libasound's syscalls.
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Not set: PrivateDevices=, DeviceAllow=, ProcSubset=pid, RestrictRealtime= (untested with a real card).

# A system unit has no $XDG_RUNTIME_DIR or $XDG_STATE_HOME, so both paths are passed.
ExecStart=@SENDSPIN_CLI_INSTALLED_BINARY@ --control-socket %t/sendspin-cli/control.sock --state-dir %S/sendspin-cli
RuntimeDirectory=sendspin-cli
StateDirectory=sendspin-cli

# Clean exit is a stop; failures (device not ready, bad config) retry every 5s indefinitely.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
