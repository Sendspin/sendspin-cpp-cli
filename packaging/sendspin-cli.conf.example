# Example sendspin-cli config: copy to /etc/sendspin-cli.conf and edit.
#
# Keys are long flag names without dashes, one 'key = value' per line; `sendspin-cli --help`
# is the reference. '#' starts a comment only at the start of a line, the last duplicate
# wins, and the command line beats the file. The first file found is read whole:
# --config <path>, $XDG_CONFIG_HOME/sendspin-cli/config, ~/.config/sendspin-cli/config,
# /etc/sendspin-cli.conf. Unknown keys and bad lines stop the player.

# The name a controller shows for this endpoint. Defaults to this host's name.
#name = kitchen

# Stable client id a server files volume and grouping under. Defaults to a MAC-derived id,
# which two players on one host would share.
#id = kitchen-left

# Device info sent in client/hello, for a product embedding this player.
#manufacturer = sendspin-cpp-cli
#product-name = sendspin-cli

# Output device: null, stdout, - or <backend>:<device>; `sendspin-cli -l` lists them.
# Under the systemd system unit, `default` usually fails: name the card, e.g. hw:1,0.
#output = default

# Audio the output backend keeps buffered, 10-2000 ms. Raise it on a device that stutters.
#buffer-ms = 100

# Preferred formats, codec:rate:depth:channels in priority order; the rest are still offered.
# A format the advertised list does not carry refuses to start.
#audio-format = flac:48000:24:2,pcm:48000:24:2

# The port this player's own WebSocket server listens on, for a server that connects in.
#port = 8928

# Dial a server instead of waiting to be found: <host>[:<port>], a ws:// URL, or mdns:<name> to
# discover one by its advertised name. Any value here disables advertising, as -s does.
#server = mdns:Living Room

# Latency added after the audio port, 0-5000 ms. A first-run default: a remembered delay wins.
#static-delay = 0

# Shell commands run on stream start and stop, with SENDSPIN_* facts in the environment.
#hook-start = amixer set Master unmute
#hook-stop = amixer set Master mute

# Log level for this player and the sendspin library together: none, error, warn, info,
# debug, verbose. Under systemd this lands in the journal.
#log-level = info

# Uncomment under the systemd unit so subcommands find its socket (root has no $XDG_RUNTIME_DIR).
#control-socket = /run/sendspin-cli/control.sock
